{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:working-deck:contracts:handoff:v1",
  "title": "Working Deck Handoff Stage Document",
  "description": "Frontmatter of a stage file under workspace-meta/handoff/<work_id>/",
  "type": "object",
  "additionalProperties": false,
  "required": ["work_id", "stage", "status", "author"],
  "properties": {
    "work_id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "stage": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "enum": ["draft", "ready", "superseded"]
    },
    "author": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^repo_[a-z0-9]+(?:_[a-z0-9]+)*$"
      }
    }
  }
}
