#!/bin/sh
# Working Deck Git guard
workspace_root=__WORKING_DECK_ROOT__

if [ ! -f "$workspace_root/_Mission-Control/git-safety.yaml" ]; then
    echo "Working Deck: configured workspace is unavailable; reinstall the pre-push guard" >&2
    exit 1
fi

exec python3 "$workspace_root/_Mission-Control/tooling/git_guard.py" pre-push "$@"
